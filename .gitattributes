# The owner works in WSL2 with core.autocrlf=true. Without this file, Git checks out
# CRLF working-tree copies and `./mvnw` dies with "bad interpreter: /bin/sh^M".
# Normalise everything to LF in the index, and force LF in the working tree for the
# files that are executed as scripts.

* text=auto eol=lf

mvnw      text eol=lf
*.sh      text eol=lf
mvnw.cmd  text eol=crlf
*.bat     text eol=crlf

*.png binary
*.jpg binary
*.jar binary
