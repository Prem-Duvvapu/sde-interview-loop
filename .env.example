# Environment variables — copy to .env and fill in your keys.
# Keys are read server-side only and never committed or sent to the browser.
# A provider with no key present simply does not appear in the UI.

# At least one of these is required for the app to be useful.
# Gemini is the default provider; Claude is an alternative interviewer.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional — enable these providers by adding your keys.
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
